# توکن جدیدی که از BotFather می‌گیری
BOT_TOKEN=

# آیدی عددی ادمین‌ها؛ چند ادمین را با کاما جدا کن
ADMIN_IDS=9158813748

# آیدی عددی چت مالک برای دریافت رسیدهای تأییدشده
OWNER_CHAT_ID=

# مسیر دیتابیس؛ در Railway با Volume روی /data تنظیم شود
DATABASE_PATH=/data/sales.db

# تصویر اختیاری؛ اگر فایل موجود نباشد، ربات پیام متنی می‌فرستد
CONFIG_IMAGE_PATH=photo_5771850719550967090_y.jpg

# اطلاعات پرداخت؛ در مخزن GitHub قرار نده
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_OWNER=

# لینک اشتراک کانفیگ؛ در مخزن عمومی قرار نده
